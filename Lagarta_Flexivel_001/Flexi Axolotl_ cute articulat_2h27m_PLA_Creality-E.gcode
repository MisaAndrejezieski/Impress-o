; start_filament_gcode = "; filament start gcode\n\n\n{if (gcode_flavor == \"klipper\" && custom_parameter_filament_enable_pressure_advance[current_extruder] == 1)}\nSET_PRESSURE_ADVANCE ADVANCE={custom_parameter_filament_pressure_advance[current_extruder]}\n{elsif (gcode_flavor == \"marlin\" || gcode_flavor ==\"marlin2\")}\nM900 K{custom_parameter_filament_pressure_advance[current_extruder]}\n{else}\nM572 D0 S{custom_parameter_filament_pressure_advance[current_extruder]}\n{endif}\n\n\n{if layer_num > disable_fan_first_layers[current_extruder] && custom_parameter_printer_auxiliary_fan == 1 && custom_parameter_filament_additional_cooling_fan_speed[current_extruder] > 0}\nM106 P2 S{custom_parameter_filament_additional_cooling_fan_speed[current_extruder] * 255 / 100}\n;set auxiliary fan speed\n{elsif layer_num > disable_fan_first_layers[current_extruder] && custom_parameter_printer_auxiliary_fan == 1}\nM106 P2 S0\n;turn off auxiliary fan speed\n{endif}\n"
